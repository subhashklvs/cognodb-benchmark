# Copy this file to .env and fill in real values. NEVER commit .env.
# Each platform below speaks Bolt/Cypher, so the same driver-based
# loaders/workloads work against all of them unmodified.

# --- CognoDB Cloud (free c0 instance) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free ---
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# --- Memgraph Cloud (free tier) ---
MEMGRAPH_URI=bolt+s://<instance-id>.memgraph.cloud
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# --- FalkorDB Cloud (free tier, Bolt-compatible via RedisGraph protocol shim) ---
FALKORDB_URI=bolt+s://<instance-id>.falkordb.cloud
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=

# --- Self-hosted Neo4j Community (docker-compose, resource-capped to match
#     CognoDB free tier: 0.5 vCPU / 256MB RAM / 1GB disk) used as a
#     "known baseline" control platform ---
SELFHOSTED_URI=bolt://localhost:7687
SELFHOSTED_USER=neo4j
SELFHOSTED_PASSWORD=benchmarkpass

# --- Benchmark run settings ---
DATASET_PATH=./data/dataset.csv
READ_ITERATIONS=100
WARMUP_ITERATIONS=20
MIXED_WORKLOAD_SECONDS=60
MIXED_WORKLOAD_CONCURRENCY=10,20,40
